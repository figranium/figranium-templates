# Database and authentication
DATABASE_URL=
JWT_SECRET=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Dedicated test-branch connection strings for read-only Neon Auth discovery only.
NEON_TEST_DATABASE_URL=
LEGACY_SOURCE_DATABASE_URL=
# Leave unset on the Neon Auth test branch. This emergency legacy path is only
# for the existing deployment until an approved bcrypt migration exists.
LEGACY_PASSWORD_LOGIN_ENABLED=

# Preset metadata generation
# gateway: any model available through Vercel AI Gateway
# gemini: direct Google Gemini API
# openai-compatible: any OpenAI-compatible provider endpoint
AI_PROVIDER=gateway
AI_API_KEY=
AI_MODEL=

# Only required when AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_PROVIDER_NAME=custom
# Set false if the compatible endpoint does not support structured outputs.
AI_STRUCTURED_OUTPUTS=true

# Search
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=presets
